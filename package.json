{
  "name": "hanlin-reader",
  "version": "2.1.0",
  "description": "An offline Chinese reading, dictionary, and pronunciation desktop app",
  "author": "Hanlin contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "electron .",
    "desktop:dev": "node scripts/dev-desktop.mjs",
    "prepare:data": "node scripts/prepare-dictionary.mjs",
    "prepare:speech": "node scripts/prepare-speech.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run prepare:notices && vite build",
    "test": "vitest run && npm run test:speech",
    "test:e2e": "playwright test",
    "package:win": "npm run prepare:data && npm run prepare:speech && npm run prepare:tts && npm run prepare:windows-speech && npm run build && electron-builder --win portable --x64",
    "package:linux": "npm run prepare:data && npm run prepare:speech && npm run prepare:tts && npm run build && electron-builder --linux dir",
    "test:speech": "node --test tests/speech-native.test.cjs",
    "prepare:windows-speech": "node scripts/prepare-windows-speech.mjs",
    "install:electron": "node node_modules/electron/install.js",
    "test:desktop": "node tests/speech-desktop-smoke.cjs",
    "prepare:tts": "node scripts/prepare-tts.mjs",
    "prepare:notices": "node scripts/prepare-notices.mjs"
  },
  "build": {
    "appId": "com.hanlin.reader",
    "productName": "Hanlin",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/models/mandarin",
        "to": "models/mandarin"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/models/mandarin-tts",
        "to": "models/mandarin-tts"
      }
    ],
    "asarUnpack": [
      "node_modules/sherpa-onnx-*/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "artifactName": "Hanlin-${version}-windows-${arch}-portable.${ext}",
      "icon": "resources/icon.ico",
      "files": [
        "dist/**/*",
        "electron/**/*",
        "package.json",
        "!node_modules/sherpa-onnx-linux-*/**/*",
        "!node_modules/sherpa-onnx-darwin-*/**/*"
      ],
      "extraResources": [
        {
          "from": "resources/native/win-x64",
          "to": "native/win-x64"
        }
      ]
    },
    "linux": {
      "target": "dir",
      "category": "Education"
    }
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cedict-json": "1.3.20251213",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "lucide-react": "1.56.0",
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.29.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
